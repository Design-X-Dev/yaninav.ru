# Скопируйте в `.env`. Файл `.env` не в git — см. .gitignore

# --- Публичный URL сайта ---
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Payload CMS ---
PAYLOAD_SECRET=replace-with-strong-random-string-min-16-chars
DATABASE_URI=file:./data/payload.db
# Однократно после создания БД (в корне проекта с теми же переменными): npm run seed:contact-form ; npm run seed:memories

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Telegram (пуш уведомлений о form-submissions — см. docs/backlog.md B-18) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- S3 ---
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
