# Скопируйте в .env и заполните значения. Файл .env в git не коммитится (см. .gitignore).

# --- Публичный URL сайта (sitemap, канонические ссылки, OG при необходимости) ---
NEXT_PUBLIC_SITE_URL=https://example.com

# --- SMTP (формы обратной связи и уведомления) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Telegram (уведомления ботом, если подключите) ---
TELEGRAM_BOT_TOKEN=

# --- S3-совместимое хранилище (медиа / загрузки при интеграции) ---
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
