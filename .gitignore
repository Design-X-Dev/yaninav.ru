/data/*.db*
/data/image/*
/data/video/*

# Одноразовая сборка migrate (генерируется `npm run migrate:payload:build`)
.migrate-bundle/

# Payload CLI: сборка конфига без tsx/tsconfig paths (esbuild)
.payload-bundle/

